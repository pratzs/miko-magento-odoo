<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- numbercall and doall are deliberately absent: Odoo 18 removed both
             from ir.cron. Active, but _cron_magento_sync only touches channels
             whose owner turned auto_sync on, which defaults to off. -->
        <record id="cron_magento_sync" model="ir.cron">
            <field name="name">Magento: scheduled sync</field>
            <field name="model_id" ref="miko_ecommerce_core.model_miko_ecommerce_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_magento_sync()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
